.DEFAULT_GOAL := help

DATA_URL := https://data.biostarhandbook.com/data
SCRIPT_URL := https://data.biostarhandbook.com/rscript

.PHONY: help data scripts hbr-data airway-data

help:
	@echo "make data        Fetch missing scripts and airway data; check local HBR/UHR inputs"
	@echo "make scripts     Download the edgeR, DESeq2, and simulation scripts if missing"
	@echo "make hbr-data    Check the included HBR/UHR design and gene counts"
	@echo "make airway-data Download the airway design and counts if missing"
	@echo "Simulated inputs are generated by the simulation command in the README."

data: scripts hbr-data airway-data

scripts: src/edger.r src/deseq2.r src/simulate_counts.r

hbr-data:
	@test -s design.csv || { echo "Missing design.csv; include the HBR/UHR design with this project." >&2; exit 1; }
	@test -s counts/gene_counts.tsv || { echo "Missing counts/gene_counts.tsv; include the processed HBR/UHR counts with this project." >&2; exit 1; }

airway-data: results/airway/design.csv results/airway/gene_counts.csv

# Download to a temporary file first so an interrupted download is not reused.
src/edger.r:
	@mkdir -p "$(@D)"
	@set -e; trap 'rm -f "$@.tmp"' EXIT; curl -fsSL "$(SCRIPT_URL)/edger.2026.r" -o "$@.tmp"; mv "$@.tmp" "$@"

src/deseq2.r:
	@mkdir -p "$(@D)"
	@set -e; trap 'rm -f "$@.tmp"' EXIT; curl -fsSL "$(SCRIPT_URL)/deseq2.2026.r" -o "$@.tmp"; mv "$@.tmp" "$@"

src/simulate_counts.r:
	@mkdir -p "$(@D)"
	@set -e; trap 'rm -f "$@.tmp"' EXIT; curl -fsSL "$(SCRIPT_URL)/simulate_counts.2026.r" -o "$@.tmp"; mv "$@.tmp" "$@"

results/airway/design.csv:
	@mkdir -p "$(@D)"
	@set -e; trap 'rm -f "$@.tmp"' EXIT; curl -fsSL "$(DATA_URL)/design.airway.2026.csv" -o "$@.tmp"; mv "$@.tmp" "$@"

results/airway/gene_counts.csv:
	@mkdir -p "$(@D)"
	@set -e; trap 'rm -f "$@.tmp"' EXIT; curl -fsSL "$(DATA_URL)/gene_counts.airway.2026.csv" -o "$@.tmp"; mv "$@.tmp" "$@"

